# Copiar a .env y ajustar. Los valores por defecto sirven para desarrollo local con Docker.

# Django
DJANGO_SECRET_KEY=django-insecure-cambiar-en-produccion
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,sifcol.pythonanywhere.com

# Base de datos (dentro de Docker, DB_HOST se fuerza a "db")
DB_NAME=inv_manaudi
DB_USER=root
DB_PASSWORD=f4d3s2a1
DB_HOST=db
DB_PORT=3306

# Puertos en el host (solo localhost)
WEB_HOST_PORT=8012
DB_HOST_PORT=3307

# 1 = correr "migrate" al arrancar el contenedor web
RUN_MIGRATIONS=1

# Orígenes de confianza para CSRF (Django 4+, con esquema)
DJANGO_CSRF_TRUSTED_ORIGINS=https://sifcol.pythonanywhere.com,http://localhost:8012,http://127.0.0.1:8012
